# Keep game images, extracted files, generated output, builds, saves, and logs local.
/*
!/.gitignore
!/README.md
!/docs/
/docs/*
!/docs/README.md
!/docs/RG-007-001.md
!/docs/RG-007-002.md
!/docs/RG-007-003.md
!/docs/RG-007-004.md
!/docs/RG-007-006.md
!/docs/RG-007-007.md
!/docs/RG-007-008.md
!/docs/RG-007-010.md
!/docs/RG-007-011.md
!/configs/
/configs/*
!/configs/quantumofsolace.toml
!/configs/quantumofsolace-60fps.toml
!/configs/legends.toml
!/assets/
/assets/*
!/assets/logo.svg
!/assets/social-preview.svg
!/assets/social-preview.png
